{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "csa-id",
  // The shared team account (issue #95). Pinned so every wrangler command and deploy goes there, whoever is signed in.
  "account_id": "82eb0e1a34cc54ba5d667cff5c406094",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "csa-id"
    }
  ],
  // Workers Free plan only: no R2, nothing that needs billing enrollment.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "csa-id",
      "database_id": "83c690f7-9929-45eb-b7cd-a9a6ae056f9f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "b68eba71c3fc4c22a6c8cbf3574515d2"
    }
  ],
  // Public Turnstile site key for csa-makati.workers.dev, which covers the live site and its previews. Local dev overrides it in .dev.vars with a test key.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGQyknxd7Oam0-E7"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Pull request and dev previews (`wrangler preview` in Workers Builds). They deliberately share the LIVE D1 and KV,
  // as the owner decided: test on a preview only with test accounts. WORKER_SELF_REFERENCE is left out because
  // previews can't take service bindings; OpenNext only needs it for revalidation queues, which this app doesn't use.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "csa-id",
        "database_id": "83c690f7-9929-45eb-b7cd-a9a6ae056f9f"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "KV",
        "id": "b68eba71c3fc4c22a6c8cbf3574515d2"
      }
    ],
    "images": {
      "binding": "IMAGES"
    },
    "vars": {
      "TURNSTILE_SITE_KEY": "0x4AAAAAAGQyknxd7Oam0-E7"
    }
  },
  "observability": {
    "enabled": true
  }
}
